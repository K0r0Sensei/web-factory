# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=45000
GEMINI_TEST_TIMEOUT_MS=20000

# Optional commercial discovery provider (DataForSEO Business Listings)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenStreetMap/Overpass experimental discovery mode
DISCOVERY_USER_AGENT=WebFactoryDiscovery/0.1 (+local prospect research)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: email address used by the public proposal CTA
WEB_FACTORY_CONTACT_EMAIL=

# Production demo persistence (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
